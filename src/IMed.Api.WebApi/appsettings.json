{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ImedApp": ""
  },
  "Keycloak": {
    "Authority": "",
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Outbox": {
    "Enabled": true,
    "IdlePollSeconds": 5,
    "BusyPollSeconds": 1,
    "BatchSize": 25,
    "BackoffBaseSeconds": 5,
    "BackoffMaxSeconds": 3600,
    "MaxAttempts": 24
  },
  "IdentifierTypes": {
    "Types": [
      {
        "CountryCode": "HN",
        "Code": "IdentidadNacional",
        "Label": "Identidad Nacional",
        "FhirSystemUri": "https://imed.app/identifiers/hn/dni",
        "Regex": "^\\d{4}-?\\d{4}-?\\d{5}$",
        "Hl7V2Code": "NI",
        "NormalizationHint": "NNNN-NNNN-NNNNN"
      },
      {
        "CountryCode": "HN",
        "Code": "Pasaporte",
        "Label": "Pasaporte",
        "FhirSystemUri": "https://imed.app/identifiers/passport",
        "Regex": "^[A-Z0-9]{6,12}$",
        "Hl7V2Code": "PPN",
        "NormalizationHint": "Alfanumérico, 6 a 12 caracteres"
      },
      {
        "CountryCode": "HN",
        "Code": "RTN",
        "Label": "RTN",
        "FhirSystemUri": "https://imed.app/identifiers/hn/rtn",
        "Regex": "^\\d{4}-?\\d{4}-?\\d{6}$",
        "Hl7V2Code": "TAX",
        "NormalizationHint": "NNNN-NNNN-NNNNNN"
      },
      {
        "CountryCode": "HN",
        "Code": "CarnetResidente",
        "Label": "Carnet de Residente",
        "FhirSystemUri": "https://imed.app/identifiers/hn/carnet-residente",
        "Regex": "^[A-Z0-9]{6,15}$",
        "Hl7V2Code": "PRC",
        "NormalizationHint": "Alfanumérico, 6 a 15 caracteres"
      }
    ]
  },
  "FhirGateway": {
    "Enabled": true,
    "Mode": "Shadow"
  }
}
